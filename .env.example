NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Secret key (sb_secret_...) or legacy service_role. Never use anon/publishable here.
SUPABASE_SERVICE_ROLE_KEY=
# Email of the one personal workspace administrator. Create this user in Supabase Auth first.
ADMIN_EMAIL=
# System User Token with ads_read, business_management, read_insights where available.
# ads_management is not needed: Ads Hub never changes live campaigns.
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
# Required for Facebook OAuth tokens stored encrypted at rest (32 random bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# v19.0 is legacy. Select a version supported by your Meta app.
META_API_VERSION=v25.0
CRON_SECRET=
# Use the actual browser origin. Facebook OAuth requires HTTPS; local HTTP can use System User Token.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Optional server-only fallback for Meta Model API. You can also connect in Meta AI & prompt.
MODEL_API_KEY=
