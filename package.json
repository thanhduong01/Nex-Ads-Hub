{
  "name": "ads-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "deploy:link": "node scripts/deploy-link.mjs",
    "setup:check": "node scripts/check-supabase.mjs",
    "format": "prettier --write components lib pages tests scripts styles docs README.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.23",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.6"
  }
}
